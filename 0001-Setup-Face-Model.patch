+          initial={{ scale: 0.85, opacity: 0 }}
+          animate={{ scale: 1, opacity: 1 }}
+          className="bg-[#00BCD4] border-4 border-black px-10 py-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] -rotate-1"
