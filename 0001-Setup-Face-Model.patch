+          <circle cx="14" cy="14" r="13" fill="#D4701D" opacity="0.6" />
+          {/* Main gold body */}
+          <circle cx="14" cy="14" r="12" fill="url(#coinGradient)" />
+          {/* Inner shine circle */}
+          <circle cx="14" cy="11" r="8" fill="#FFEB52" opacity="0.6" />
