+            "what_it_means": arousal_meaning,
+        },
+
+        "higher_cognition_gamma": {
+            "score_out_of_100": gamma_score,
+            "label": gamma_label,
+            "gamma_percent_of_total": brainwave_percentages["gamma_percent"],
+            "what_it_means": gamma_meaning,
