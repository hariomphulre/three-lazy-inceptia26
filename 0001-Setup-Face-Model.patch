+}
+
+/* ─── DETAILED PIPE (3D Green Pipe with Rim) ─── */
+export function Pipe({ color = "green", className = "" }: { color?: "green" | "red"; className?: string }) {
+  const c = color === "green"
+    ? { body: "#43A047", rim: "#2E7D32", hi: "#66BB6A", dark: "#1B5E20", light: "#7AC74F" }
