	"sup_title": "ಬೆಂಬಲ",
	"sup_subtitle": "ಸಹಾಯ & ಪದೇ ಪದೇ ಕೇಳಲಾಗುವ ಪ್ರಶ್ನೆಗಳು",
	"sup_contact": "ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ",
	"sup_contact_desc": "ನಾವು ಸಾಮಾನ್ಯವಾಗಿ 1–2 ಕೆಲಸದ ದಿನಗಳಲ್ಲಿ ಪ್ರತ್ಯುತ್ತರಿಸುತ್ತೇವೆ.",
	"sup_faq_heading": "ಪದೇ ಪದೇ ಕೇಳಲಾಗುವ ಪ್ರಶ್ನೆಗಳು",
	"sup_faq1_q": "ಮೌಲ್ಯಮಾಪನವನ್ನು ನಾನು ಹೇಗೆ ಪ್ರಾರಂಭಿಸುವುದು?",
	"sup_faq1_a": "ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ತೆರೆದು “Start Assessment” ಕ್ಲಿಕ್ ಮಾಡಿ. ಶಿಕ್ಷಕರೊಬ್ಬರು ನಿಮಗೆ ಆಹ್ವಾನ ಕಳುಹಿಸಿದ್ದರೆ, ಮಗುವಿನ ಹೆಸರು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ತುಂಬಲ್ಪಡುತ್ತದೆ — ನೀವು ಕೇವಲ ವಯಸ್ಸು ಮತ್ತು ಲಿಂಗವನ್ನು ಸೇರಿಸಿ, ನಂತರ ಆರು ಚಿಕ್ಕ ಚಟುವಟಿಕೆಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ.",
	"sup_faq2_q": "ನನ್ನ ಮಗುವಿನ ಸ್ಥಿತಿಯನ್ನು ಯಾರು ನಿರ್ಧರಿಸುತ್ತಾರೆ?",
	"sup_faq2_a": "ಯಾರೂ ಅದನ್ನು ಕೈಯಾರೆ ಆಯ್ಕೆ ಮಾಡುವುದಿಲ್ಲ. ಚಟುವಟಿಕೆಗಳು ಪೂರ್ಣಗೊಂಡ ನಂತರ ಸ್ಥಿತಿಯನ್ನು ಮೌಲ್ಯಮಾಪನ ವರದಿಯಿಂದ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನಿರ್ಧರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ ಪತ್ತೆಯಾದ ಕ್ಷೇತ್ರಗಳಾಗಿ ತೋರಿಸಲಾಗುತ್ತದೆ.",
	"sup_faq3_q": "ವರದಿಯನ್ನು ಪರಿಶೀಲಿಸಲು ಒಬ್ಬ ತಜ್ಞರನ್ನು ಹೇಗೆ ಪಡೆಯುವುದು?",
	"sup_faq3_a": "ನಿಮ್ಮ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಲ್ಲಿ “Specialist Support” ತೆರೆದು ನೋಂದಾಯಿತ ವೈದ್ಯ ಅಥವಾ ಮನಶ್ಶಾಸ್ತ್ರಜ್ಞರಿಗೆ ವಿನಂತಿಯನ್ನು ಕಳುಹಿಸಿ. ಅಲ್ಲಿ ಸ್ಥಿತಿ (ಬಾಕಿ / ಸ್ವೀಕರಿಸಲಾಗಿದೆ) ನವೀಕರಣಗೊಳ್ಳುವುದನ್ನು ನೀವು ನೋಡುತ್ತೀರಿ.",
	"sup_faq4_q": "ನನ್ನ ಮಗುವಿನ ಡೇಟಾ ಖಾಸಗಿಯಾಗಿದೆಯೇ?",
	"sup_faq4_a": "ಮೌಲ್ಯಮಾಪನ ಡೇಟಾ ಕೇವಲ ನಿಮ್ಮ ಖಾತೆಗೆ ಮತ್ತು ನೀವು ಸಂಪರ್ಕಗೊಂಡಿರುವ ಶಿಕ್ಷಕ/ತಜ್ಞರಿಗೆ ಮಾತ್ರ ಲಿಂಕ್ ಆಗಿರುತ್ತದೆ. ವರದಿಗಳು ಮತ್ತು ಮಾಧ್ಯಮಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಎಂದಿಗೂ ಸಾರ್ವಜನಿಕವಾಗಿ ಹಂಚಿಕೊಳ್ಳಲಾಗುವುದಿಲ್ಲ.",
	"sup_faq5_q": "ಇದು ಇಂಟರ್ನೆಟ್ ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡುತ್ತದೆಯೇ?",
	"sup_faq5_a": "ಆ್ಯಪ್ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಬಹುದಾಗಿದೆ ಮತ್ತು ಹಿಂದೆ ತೆರೆದ ಪುಟಗಳು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಲೋಡ್ ಆಗುತ್ತವೆ. ಮೌಲ್ಯಮಾಪನ ಉತ್ತರಗಳನ್ನು ಸಾಧನದಲ್ಲಿ ಸೆರೆಹಿಡಿಯಲಾಗುತ್ತದೆ ಮತ್ತು ಸಂಪರ್ಕ ಮರಳಿದಾಗ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರ್ವರ್‌ಗೆ ಸಿಂಕ್ ಆಗುತ್ತವೆ.",
	"sup_link_dashboard": "ಡ್ಯಾಶ್‌ಬೋರ್ಡ್",
	"sup_link_reports": "ವರದಿಗಳು",
	"sup_link_psychologists": "ಮನಶ್ಶಾಸ್ತ್ರಜ್ಞರು",
	"sup_note_privacy": "ನಿಮ್ಮ ಡೇಟಾ ಖಾಸಗಿಯಾಗಿ ಉಳಿಯುತ್ತದೆ — ಕೇವಲ ನಿಮ್ಮ ಖಾತೆಗೆ ಮತ್ತು ನೀವು ಸಂಪರ್ಕಿಸುವ ಜನರಿಗೆ ಮಾತ್ರ ಲಿಂಕ್ ಆಗಿರುತ್ತದೆ.",
